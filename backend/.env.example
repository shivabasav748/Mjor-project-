# ─────────────────────────────────────────────
#  VentureIQ Backend — Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Gemini AI API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key (change this to a long random string in production)
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database URL (defaults to SQLite for local dev)
DATABASE_URL=sqlite:///./ventureiq.db
