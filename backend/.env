# VentureIQ Backend — Environment Variables
# ─────────────────────────────────────────
# STEP 1: Get your free Gemini API key from https://aistudio.google.com/app/apikey
# STEP 2: Paste it below replacing "your_gemini_api_key_here"
# STEP 3: Restart the backend server

GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key (change this in production!)
SECRET_KEY=ventureiq-secret-key-change-in-production

# Database (leave as SQLite for local development)
DATABASE_URL=sqlite:///./ventureiq.db
